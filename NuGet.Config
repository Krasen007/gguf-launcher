<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The machine-wide NuGet config lists an unreachable mirror, which makes every
    restore fail with NU1301. Clearing the inherited sources here keeps the
    build reproducible without touching the global configuration.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
