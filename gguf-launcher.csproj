<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows only: the launcher registers file associations and calls into shell32.dll. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>GgufLauncher</RootNamespace>
    <AssemblyName>GgufLauncher</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>12</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Version>1.1.0</Version>
    <Description>A GGUF model launcher for Windows</Description>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinForms is trim-compatible on .NET 6+. Partial mode trims only our app code and
         preserves framework assemblies, avoiding WinForms trim warnings while cutting the
         self-contained exe size. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Opt into WinForms trimming (SDK otherwise errors with NETSDK1175). -->
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <!-- Note: PublishAot cannot be combined with PublishSingleFile -->
  </PropertyGroup>

  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- Smaller by not loading globalization data -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Pre-compiles assemblies to native code for faster startup on Windows (WinForms can't use Native AOT yet). -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
  </ItemGroup>
</Project>
