<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows only: the launcher registers file associations and calls into shell32.dll. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>GgufLauncher</RootNamespace>
    <AssemblyName>GgufLauncher</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>12</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Version>1.1.4</Version>
    <Description>A GGUF model launcher for Windows</Description>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Trimming -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Opt into WinForms trimming (SDK otherwise errors with NETSDK1175). -->
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <!-- FIX for TypeLoadException in Interop.UiaCore.UiaReturnRawElementProvider:
         WinForms' UI Automation provider needs built-in COM interop, which the trimmer
         disables by default. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- Single-file, self-contained publish -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Size reductions -->
  <PropertyGroup>
    <!-- ReadyToRun roughly doubles IL size; disabled for a smaller exe (slightly slower startup). -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- No PDB embedded in the exe. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Strip runtime features this app doesn't use. -->
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the WinForms layer untouched by the trimmer. -->
    <TrimmerRootAssembly Include="System.Windows.Forms" />
    <TrimmerRootAssembly Include="System.Windows.Forms.Primitives" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
  </ItemGroup>

</Project>